# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Google Drive API Key (from Google Cloud Console)
GOOGLE_API_KEY=your_google_api_key_here

# Public Google Drive folder link
GOOGLE_DRIVE_LINK=https://drive.google.com/drive/folders/your_folder_id

# Admin user IDs (comma-separated, get from @userinfobot)
ADMIN_USER_IDS=123456789,987654321

# Check interval in hours (default: 48 = 2 days)
CHECK_INTERVAL_HOURS=48
